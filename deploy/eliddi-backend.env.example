# Copy to /etc/eliddi-backend.env, then:
#   chown root:eliddi /etc/eliddi-backend.env && chmod 640 /etc/eliddi-backend.env
# One NAME=value per line, no quotes, no spaces around "=".
# Every setting is explained in docs/production.md.

# --- required ---------------------------------------------------------------

# The SQLite file. Keep it on the folder the service may write (/var/lib/eliddi).
ELIDDI_DATABASE=/var/lib/eliddi/eliddi.sqlite3

# Refuse a Diary sent without a login. Must be on for a server others can reach.
ELIDDI_REQUIRE_AUTH=1

# The page(s) allowed to call this backend: the origin (scheme + host, no path) of
# each study site, comma-separated. NOT "*".
ELIDDI_CORS_ORIGINS=https://CHANGE-ME.example.org

# One proxy (nginx) sits in front, so the client address is read from the header it sets.
ELIDDI_PROXY_HOPS=1

# --- strongly recommended -----------------------------------------------------

# Key for hashing login codes. Generate once with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# KEEP IT (and back it up): without it every stored code stops working.
# If unset, a random key is created in /var/lib/eliddi/code_hash_key instead.
ELIDDI_CODE_HASH_KEY=CHANGE-ME

# --- leave unset in production ------------------------------------------------

# ELIDDI_DUMMY_RESPONDENTS   test-phase login codes written to the log; NEVER set this on a real server

# --- optional (defaults shown) ------------------------------------------------

# ELIDDI_TOKEN_LIFETIME=43200        seconds a login lasts (12 h)
# ELIDDI_LOGIN_MAX_FAILURES=10       wrong codes allowed per address...
# ELIDDI_LOGIN_WINDOW=900            ...within this many seconds
# ELIDDI_STATE_MAX_BYTES=1000000     largest diary snapshot accepted
# ELIDDI_CODE_LENGTH=8
# ELIDDI_CODE_ALPHABET=ABCDEFGHJKMNPQRSTUVWXYZ23456789
